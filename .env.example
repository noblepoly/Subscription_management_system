# Brightloop System Environment Configuration Template
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=brightloop-hackathon-secure-jwt-key-change-in-prod-2026
PORT=5000

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=brightloop_db
DATABASE_URL=postgresql+psycopg://postgres:your_postgres_password_here@127.0.0.1:5432/brightloop_db

# Frontend URL for CORS
CORS_ORIGIN=http://localhost:5173
